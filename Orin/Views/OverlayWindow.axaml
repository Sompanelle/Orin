<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Orin.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Orin.Views.OverlayWindow"
        x:DataType="vm:OverlayWindowViewModel"
        Title="OverlayWindow"
        x:Name="Overlay"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowDecorations="None"
        WindowStartupLocation="Manual"
        Height="50"
        Width="400"
        Position="0,0"
        Topmost="True"
        >
    
    

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:OverlayWindowViewModel/>
    </Design.DataContext>
    
    <Window.Styles>
        <Style Selector="Svg.PlaybackControls">
            <Setter Property="Css" Value="{Binding SvgColorString}"></Setter>
        </Style>
    </Window.Styles>
    
        
        <StackPanel Orientation="Vertical" VerticalAlignment="Center">
           
            <!--  Playback Stackpanel !-->
            <StackPanel Orientation="Horizontal" Margin="8 4" Spacing="6">
                
                <Image Source="{Binding Thumbnail}" Height="40" Name="Thumbnail"/>
        
                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Song}" FontWeight="Bold" FontSize="16" Name="Song"/>
                    <TextBlock Text="{Binding Artist}" FontSize="12" Name="Artist"/>
                </StackPanel>
                
                <!-- Playback Controls !-->
                <StackPanel Classes="PlaybackControlsStack"
                            IsVisible="{Binding DisplayPlaybackControls}">
                    
                    <Button Classes="Playback"
                            Command="{Binding PrevCommand}"
                            CommandParameter="{Binding CurrentSession}">

                        <Svg Path="../Assets/Prev.svg"  Classes="PlaybackControls"/>
                    </Button>
                    
                    <Button Classes="Playback"
                            Command="{Binding PausePlayCommand}"
                            CommandParameter="{Binding CurrentSession}">
                        <Svg Path="{Binding  PlayingStatusImg}" Classes="PlaybackControls"/>
                    </Button>
                    
                    <Button Classes="Playback"
                            Command="{Binding SkipCommand}"
                            CommandParameter="{Binding CurrentSession}">
                        <Svg Path="../Assets/Next.svg" Classes="PlaybackControls"/>
                    </Button>
                </StackPanel>
            </StackPanel>
            
        </StackPanel>
        
</Window>