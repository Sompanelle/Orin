<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Orin.ViewModels"
        mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="150"
        x:Class="Orin.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        WindowStartupLocation="CenterScreen"
        Title="MainWindow"
        Width="300"
        Height="150">


        
        <StackPanel Name="OverlayStackPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                
                
                <Button HorizontalAlignment="Center"
                        Command="{Binding OverlayButtonClickCommand}" 
                        Content="{Binding OverlayText}">
                </Button>
                
                <StackPanel>
                        
                        <TextBlock HorizontalAlignment="Center">Media Source</TextBlock>
                        
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                        
                                <ComboBox ItemsSource="{Binding MediaSessions}" PlaceholderText="Media Source" SelectedItem="{Binding SelectedSession}" IsEnabled="{Binding IsOverlayVisible}">
                                        <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                        <TextBlock Text="{Binding SourceAppUserModelId}">
                                                        </TextBlock>
                                                </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                </ComboBox>
                                
                                <StackPanel>
                                        <Button Classes="RefreshButton" Command="{Binding RefreshMediaSessions}" CommandParameter="{Binding }" IsEnabled="{Binding IsOverlayVisible}">
                                                ⟳
                                                
                                        </Button>
                                </StackPanel>
                                
                        </StackPanel>

                </StackPanel>
                
                <TextBlock HorizontalAlignment="Center">
                        Overlay Options
                </TextBlock>

        </StackPanel>
        
    
</Window>
